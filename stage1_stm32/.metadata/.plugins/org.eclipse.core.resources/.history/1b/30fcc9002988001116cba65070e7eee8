void print_uart(const char *str)
{
    HAL_UART_Transmit(&huart2, (uint8_t *)str, strlen(str), HAL_MAX_DELAY);
}

// Single 40-bit SPI write. addr gets the write bit (0x80) set automatically.
void tmc5160_write_reg(uint8_t addr, uint32_t data)
{
    uint8_t tx[5];
    uint8_t rx[5];

    tx[0] = addr | 0x80;
    tx[1] = (data >> 24) & 0xFF;
    tx[2] = (data >> 16) & 0xFF;
    tx[3] = (data >> 8)  & 0xFF;
    tx[4] = data & 0xFF;

    SPI_CS_ENABLE();
    HAL_SPI_TransmitReceive(&hspi1, tx, rx, 5, HAL_MAX_DELAY);
    SPI_CS_DISABLE();
}

// TMC5160 read protocol requires two transactions: the first transaction's
// response is stale (it returns whatever the PREVIOUS read request asked
// for). The second transaction, sent right after, returns the data for
// THIS address. Both transactions are issued here so callers always get
// a correct, current value with a single function call.
uint32_t tmc5160_read_reg(uint8_t addr)
{
    uint8_t tx[5] = { addr, 0x00, 0x00, 0x00, 0x00 };
    uint8_t rx[5];

    SPI_CS_ENABLE();
    HAL_SPI_TransmitReceive(&hspi1, tx, rx, 5, HAL_MAX_DELAY);   // throwaway
    SPI_CS_DISABLE();

    SPI_CS_ENABLE();
    HAL_SPI_TransmitReceive(&hspi1, tx, rx, 5, HAL_MAX_DELAY);   // real data
    SPI_CS_DISABLE();

    return ((uint32_t)rx[1] << 24) | ((uint32_t)rx[2] << 16) |
           ((uint32_t)rx[3] << 8)  |  (uint32_t)rx[4];
}

// Position/velocity progress snapshot -- call this WHILE the driver is
// enabled, not after DRV_DISABLE(). Fault decoding itself now lives in
// tmc5160_report_faults() (shared with the DIAG0/DIAG1 interrupt path), so
// this function only reports motion progress, not faults.
void tmc5160_status_line(const char *label)
{
    char buf[100];

    int32_t  xactual = (int32_t)tmc5160_read_reg(REG_XACTUAL);
    int32_t  vactual = (int32_t)tmc5160_read_reg(REG_VACTUAL);

    sprintf(buf, "%-10s XACTUAL=%-7ld VACTUAL=%-6ld\r\n",
            label, (long)xactual, (long)vactual);
    print_uart(buf);
}

// Reads DRV_STATUS + GSTAT, prints which fault/warning bits are set (if any),
// then clears the latched GSTAT flags. "source" identifies what triggered the
// read (e.g. "DIAG0", "DIAG1", or a periodic label) so the UART log shows why
// a status read happened.
//
// Bit positions verified against the TMC5160 register map (DRV_STATUS,
// addr 0x6F):
//   bit31 stst   bit30 olb   bit29 ola   bit28 s2gb   bit27 s2ga
//   bit26 otpw   bit25 ot    bit24 stallGuard
//   bits20:16 cs_actual (5 bits)     bit13 s2vsb   bit12 s2vsa
static void tmc5160_report_faults(const char *source)
{
    uint32_t drvstatus = tmc5160_read_reg(REG_DRV_STATUS);
    uint32_t gstat     = tmc5160_read_reg(REG_GSTAT);
    char buf[96];

    sprintf(buf, "[%s] DRV_STATUS=0x%08lX GSTAT=0x%08lX -- ",
            source, (unsigned long)drvstatus, (unsigned long)gstat);
    print_uart(buf);

    int any_fault = 0;
    if (drvstatus & (1UL << 25)) { print_uart("OT(overtemp shutdown) ");        any_fault = 1; }
    if (drvstatus & (1UL << 26)) { print_uart("OTPW(overtemp prewarn) ");       any_fault = 1; }
    if (drvstatus & (1UL << 28)) { print_uart("S2GB(short to GND, B) ");        any_fault = 1; }
    if (drvstatus & (1UL << 27)) { print_uart("S2GA(short to GND, A) ");        any_fault = 1; }
    if (drvstatus & (1UL << 13)) { print_uart("S2VSB(short to supply, B) ");    any_fault = 1; }
    if (drvstatus & (1UL << 12)) { print_uart("S2VSA(short to supply, A) ");    any_fault = 1; }
    if (drvstatus & (1UL << 30)) { print_uart("OLB(open load, B) ");            any_fault = 1; }
    if (drvstatus & (1UL << 29)) { print_uart("OLA(open load, A) ");            any_fault = 1; }
    if (drvstatus & (1UL << 24)) { print_uart("STALLGUARD ");                   any_fault = 1; }
    if (gstat & 0x2)             { print_uart("DRV_ERR(latched driver error) ");any_fault = 1; }
    if (gstat & 0x4)             { print_uart("UV_CP(charge pump undervoltage) ");any_fault = 1; }
    if (!any_fault)              { print_uart("(no fault bits set -- spurious or benign edge) "); }

    print_uart("\r\n");

    // Clear latched GSTAT flags (reset/drv_err/uv_cp) now that they've been reported.
    tmc5160_write_reg(REG_GSTAT, 0x00000007);
}

// --- Microsecond delay via DWT cycle counter (SysTick alone only gives ms
// resolution, which is far too coarse for STEP pulse timing). Standard,
// well-established technique on Cortex-M3/M4/M7.
static void DWT_Init(void)
{
    CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
    DWT->CYCCNT = 0;
    DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
}

static void delay_us(uint32_t us)
{
    uint32_t start = DWT->CYCCNT;
    uint32_t ticks = us * (SystemCoreClock / 1000000UL);
    while ((DWT->CYCCNT - start) < ticks) { }
}

// steps = |angle| / 360 * fullsteps_per_rev * microsteps_per_fullstep,
// done in integer arithmetic (no float) so the result is deterministic.
static uint32_t angle_to_microsteps(int32_t angle_deg)
{
    int32_t mag = (angle_deg < 0) ? -angle_deg : angle_deg;
    uint64_t num = (uint64_t)mag * MOTOR_FULLSTEPS_PER_REV * MICROSTEPS_PER_FULLSTEP;
    return (uint32_t)(num / 360);
}

// Blocking STEP/DIR move: sets DIR, waits a short setup margin, then emits
// n_steps pulses on STEP spaced STEP_INTERVAL_US apart. This is the only
// thing that actually turns the motor now that SD_MODE is fixed at 1 --
// SPI never touches motion registers.
static void tmc_step_move(uint32_t n_steps, uint8_t dir_forward)
{
    DIR_SET(dir_forward);
    delay_us(10);   // DIR-to-STEP setup margin

    for (uint32_t i = 0; i < n_steps; i++)
    {
        STEP_HIGH();
        delay_us(STEP_PULSE_HIGH_US);
        STEP_LOW();
        delay_us(STEP_INTERVAL_US - STEP_PULSE_HIGH_US);
    }
}

