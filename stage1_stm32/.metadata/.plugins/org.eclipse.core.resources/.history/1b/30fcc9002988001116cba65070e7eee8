#define REG_TPOWERDOWN		0x11
#define REG_TCOOLTHRS		0x14
#define REG_XACTUAL			0x21
#define REG_VACTUAL			0x22
#define REG_GLOBAL_SCALER	0x0B
#define REG_CHOPCONF		0x6C
#define REG_DRV_STATUS		0x6F

/* GCONF (0x00) bit positions used below -- verified against Trinamic's
 * published register map (bit layout is identical across independent
 * open-source TMC5160 drivers: klipper-tmc5160, Trinamic-library, TMCStepper). */
#define GCONF_DIAG0_ERROR			(1UL << 5)   // DIAG0 pulses on any driver error (OT/S2G/UVLO)
#define GCONF_DIAG0_OTPW			(1UL << 6)   // DIAG0 also pulses on overtemperature pre-warning
#define GCONF_DIAG1_STALL			(1UL << 8)   // DIAG1 pulses on StallGuard stall event
#define GCONF_DIAG0_INT_PUSHPULL	(1UL << 12)  // DIAG0 = push-pull, active-HIGH (not open-drain)
#define GCONF_DIAG1_PUSHPULL		(1UL << 13)  // DIAG1 = push-pull, active-HIGH (not open-drain)

// --- Motor / microstepping geometry -----------------------------------------
// MICROSTEPS_PER_FULLSTEP must always match the MRES field written into
// CHOPCONF below: MRES -> microsteps/fullstep is 2^(8-MRES), except MRES=8
// (special-cased fullstep = 1). Each STEP pulse advances the driver by
// exactly one microstep at this MRES setting, whether SD_MODE is 0 or 1 --
// this counting relationship does NOT depend on SD_MODE.
#define MOTOR_FULLSTEPS_PER_REV		200		// 1.8 deg/step motor. Use 400 for a 0.9 deg/step motor.
#define MICROSTEPS_PER_FULLSTEP		16		// Must match MRES=4 in CHOPCONF below.

// Angle to rotate, in degrees. Sign selects direction:
//   positive -> DIR pin driven HIGH ("forward")
//   negative -> DIR pin driven LOW  ("reverse")
// Magnitude is how far the motor turns before stopping.
// NOTE: whether HIGH/LOW is actually "forward" on your hardware depends on
// motor wiring -- if it spins the wrong way, either negate this macro or
// swap two motor phase wires; there's no way to know that from software.
#define ROTATION_ANGLE_DEG		90

// STEP pulse timing. STEP_INTERVAL_US is the time between rising edges and
// therefore sets rotation speed (smaller = faster); STEP_PULSE_HIGH_US is
// how long STEP is held high per pulse (datasheet minimum is far below this,
// a couple of microseconds is a safe, unambitious margin).
#define STEP_PULSE_HIGH_US		2
#define STEP_INTERVAL_US		800

