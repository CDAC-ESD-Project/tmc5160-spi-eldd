#define DIAG1_GPIO_Port		GPIOB
#define DIAG1_Pin			GPIO_PIN_3

#define STEP_HIGH()			HAL_GPIO_WritePin(STEP_GPIO_Port, STEP_Pin, GPIO_PIN_SET)
#define STEP_LOW()			HAL_GPIO_WritePin(STEP_GPIO_Port, STEP_Pin, GPIO_PIN_RESET)
#define DIR_SET(fwd)		HAL_GPIO_WritePin(DIR_GPIO_Port, DIR_Pin, (fwd) ? GPIO_PIN_SET : GPIO_PIN_RESET)

#define REG_GCONF			0x00
#define REG_GSTAT			0x01
#define REG_IOIN			0x04
