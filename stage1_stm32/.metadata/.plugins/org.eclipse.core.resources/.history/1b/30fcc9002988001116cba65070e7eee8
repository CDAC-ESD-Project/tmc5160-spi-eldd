/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_SPI1_Init();
  /* USER CODE BEGIN 2 */
  DWT_Init();

  SPI_CS_DISABLE();
  DRV_DISABLE();
  STEP_LOW();
  DIR_SET(1);
  HAL_Delay(1000);   // let supply rails and charge pump settle before any SPI traffic

  DRV_ENABLE();
  HAL_Delay(10);

  print_uart("---- TMC5160 bring-up (STEP/DIR motion, SPI config-only) ----\r\n");

  // --- Sanity check: confirm SPI link and identify the chip before touching motion ---
  // IOIN.VERSION should read 0x30 for genuine TMC5160 silicon. SD_MODE is
  // expected to read 1 here -- it's hardwired on this board, which is exactly
  // why this firmware drives the motor over STEP/DIR instead of SPI motion
  // registers.
  uint32_t ioin = tmc5160_read_reg(REG_IOIN);
  char buf[120];
  sprintf(buf, "IOIN=0x%08lX  VERSION=0x%02lX  SD_MODE=%lu  DRV_ENN=%lu  "
               "STEP_pin=%lu  DIR_pin=%lu\r\n",
          (unsigned long)ioin,
          (unsigned long)((ioin >> 24) & 0x1),   // VERSION
          (unsigned long)((ioin >> 6)  & 0x1),   // SD_MODE  <- bit 6
          (unsigned long)((ioin >> 4)  & 0x1),   // DRV_ENN  <- bit 4
          (unsigned long)((ioin >> 0)  & 0x1),   // STEP pin state (diagnostic)
          (unsigned long)((ioin >> 1)  & 0x1));  // DIR  pin state (diagnostic)
  print_uart(buf);

  // Clear any stale GSTAT flags (reset / undervoltage latch) from power-up
  tmc5160_write_reg(REG_GSTAT, 0x00000007);
  HAL_Delay(5);

  // --- Driver configuration over SPI (current, microstepping, chopper, diagnostics) ---
  // SpreadCycle (not StealthChop) for bring-up -- more predictable. DIAG0 is
  // routed to fire on any driver error or overtemp pre-warning; DIAG1 is
  // routed to fire on StallGuard stall. Both are set to push-pull/active-HIGH
  // so they can be wired straight into the MCU's EXTI inputs with no external
  // pull-up needed.
  //
  // NOTE: TCOOLTHRS is left at 0 below (StallGuard/CoolStep evaluation is
  // gated off across the whole speed range), so DIAG1_STALL will not
  // actually assert yet -- the interrupt path is wired and ready, but stall
  // detection itself needs TCOOLTHRS set to a real TSTEP-based threshold
  // (and SGT tuned via COOLCONF, 0x6D) before DIAG1 will ever fire.
  tmc5160_write_reg(REG_GCONF, GCONF_DIAG0_ERROR | GCONF_DIAG0_OTPW |
                                GCONF_DIAG1_STALL |
                                GCONF_DIAG0_INT_PUSHPULL | GCONF_DIAG1_PUSHPULL);

  // MRES=4 (16 microsteps/fullstep), TOFF=3, HSTRT=5, HEND=2, TBL=2, intpol=1.
  // Deliberately coarse microstepping for this bring-up -- higher torque per
  // step makes genuine rotation visually unambiguous. Raise MRES later once
  // motion is confirmed correct (and update MICROSTEPS_PER_FULLSTEP to match).
  tmc5160_write_reg(REG_CHOPCONF, 0x14010153);

  tmc5160_write_reg(REG_GLOBAL_SCALER, 0x000000C8);  // 200/256 current scaling

  // IHOLD=10, IRUN=22, IHOLDDELAY=6 -- moderate run current, reduced hold current.
  // Verify against your own sense resistor / motor rating before relying on
  // this for a real load.
  tmc5160_write_reg(REG_IHOLD_IRUN, 0x0006160A);
  tmc5160_write_reg(REG_TPOWERDOWN, 0x0000000A);
  tmc5160_write_reg(REG_TCOOLTHRS, 0x00000000);   // see NOTE above re: DIAG1_STALL

  tmc5160_write_reg(REG_XACTUAL, 0x00000000);      // define current position as zero -- once only
  HAL_Delay(5);

  // --- The actual move: STEP/DIR pulses generated by this MCU, sized from ROTATION_ANGLE_DEG ---
  uint32_t n_steps    = angle_to_microsteps(ROTATION_ANGLE_DEG);
  uint8_t  dir_forward = (ROTATION_ANGLE_DEG >= 0) ? 1 : 0;

  sprintf(buf, "Moving %d deg (%s, %lu microsteps) via STEP/DIR...\r\n",
          ROTATION_ANGLE_DEG, dir_forward ? "forward" : "reverse",
          (unsigned long)n_steps);
  print_uart(buf);

  tmc_step_move(n_steps, dir_forward);

  // Brief settle/verify window: confirm XACTUAL landed where expected and
  // the driver reports standstill (VACTUAL back to 0).
  for (int i = 0; i < 10; i++)
  {
      char label[16];
      sprintf(label, "t=%dms", i * 100);
      tmc5160_status_line(label);
      HAL_Delay(100);
  }

  print_uart("---- move complete -- driver left enabled, monitoring DIAG0/DIAG1 ----\r\n");

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    // Bottom half of the DIAG0/DIAG1 ISRs: the ISR only sets a flag (see
    // HAL_GPIO_EXTI_Callback below), all the actual SPI/UART work happens
    // here in normal (non-interrupt) context.
    if (diag0_event)
    {
        diag0_event = 0;
        tmc5160_report_faults("DIAG0");
    }
    if (diag1_event)
    {
        diag1_event = 0;
        tmc5160_report_faults("DIAG1");
    }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

