// transmit information over UART
void print_uart(const char *str) {
    HAL_UART_Transmit(&huart2, (uint8_t *)str, strlen(str), HAL_MAX_DELAY);
}

// write to TMC5160 registers
void tmc5160_write_reg(uint8_t addr, uint32_t data) {
    uint8_t tx[5];
    uint8_t rx[5];

    tx[0] = addr | 0x80;	// addr gets the write bit (0x80)
    tx[1] = (data >> 24) & 0xFF;
    tx[2] = (data >> 16) & 0xFF;
    tx[3] = (data >> 8)  & 0xFF;
    tx[4] = data & 0xFF;

    SPI_CS_ENABLE();
    HAL_SPI_TransmitReceive(&hspi1, tx, rx, 5, HAL_MAX_DELAY);
    SPI_CS_DISABLE();
}

// read from TMC5160 registers
uint32_t tmc5160_read_reg(uint8_t addr) {
    uint8_t tx[5] = { addr, 0x00, 0x00, 0x00, 0x00 };
    uint8_t rx[5];

    SPI_CS_ENABLE();
    HAL_SPI_TransmitReceive(&hspi1, tx, rx, 5, HAL_MAX_DELAY);   // throwaway transaction
    SPI_CS_DISABLE();

    SPI_CS_ENABLE();
    HAL_SPI_TransmitReceive(&hspi1, tx, rx, 5, HAL_MAX_DELAY);   // real data transaction
    SPI_CS_DISABLE();

    return ((uint32_t)rx[1] << 24) | ((uint32_t)rx[2] << 16) |
           ((uint32_t)rx[3] << 8)  |  (uint32_t)rx[4];
}

// position and velocity progress
void tmc5160_status_line(void) {
    char buf[100];

    int32_t  xactual = (int32_t)tmc5160_read_reg(REG_XACTUAL);
    int32_t  vactual = (int32_t)tmc5160_read_reg(REG_VACTUAL);

    sprintf(buf, " XACTUAL=%-7ld VACTUAL=%-6ld\r\n", (long)xactual, (long)vactual);
    print_uart(buf);
}

// read DRV_STATUS and GSTAT registers, and print according to fault bits set (if any)
static void tmc5160_report_faults(const char *source) {
    uint32_t drvstatus = tmc5160_read_reg(REG_DRV_STATUS);
    uint32_t gstat     = tmc5160_read_reg(REG_GSTAT);
    char buf[96];

    // source identifies what triggered the read (DIAG0 or DIAG1)
    sprintf(buf, "[%s] DRV_STATUS=0x%08lX GSTAT=0x%08lX -- ", source, (unsigned long)drvstatus, (unsigned long)gstat);
    print_uart(buf);

    int any_fault = 0;
    if (drvstatus & (1UL << 25)) {
    	print_uart("OT(overtemp shutdown) ");
    	any_fault = 1;
    }
    if (drvstatus & (1UL << 26)) {
    	print_uart("OTPW(overtemp prewarn) ");
    	any_fault = 1;
    }
    if (drvstatus & (1UL << 28)) {
    	print_uart("S2GB(short to GND, B) ");
    	any_fault = 1;
    }
    if (drvstatus & (1UL << 27)) {
    	print_uart("S2GA(short to GND, A) ");
    	any_fault = 1;
    }
    if (drvstatus & (1UL << 13)) {
    	print_uart("S2VSB(short to supply, B) ");
    	any_fault = 1;
    }
    if (drvstatus & (1UL << 12)) {
    	print_uart("S2VSA(short to supply, A) ");
    	any_fault = 1;
    }
    if (drvstatus & (1UL << 30)) {
    	print_uart("OLB(open load, B) ");
    	any_fault = 1;
    }
    if (drvstatus & (1UL << 29)) {
    	print_uart("OLA(open load, A) ");
    	any_fault = 1;
    }
    if (drvstatus & (1UL << 24)) {
    	print_uart("STALLGUARD ");
    	any_fault = 1;
    }
    if (gstat & 0x2) {
    	print_uart("DRV_ERR(latched driver error) ");
    	any_fault = 1;
    }
    if (gstat & 0x4) {
    	print_uart("UV_CP(charge pump undervoltage) ");
    	any_fault = 1;
    }
    if (!any_fault) {
    	print_uart("(no fault bits set: spurious or benign edge) ");
    }

    print_uart("\r\n");

    // clear latched GSTAT flags
    tmc5160_write_reg(REG_GSTAT, 0x00000007);
}

// fine, microsecond delay using DWT Cycle Counter
static void DWT_Init(void) {
    CoreDebug->DEMCR |= CoreDebug_DEMCR_TRCENA_Msk;
    DWT->CYCCNT = 0;
    DWT->CTRL |= DWT_CTRL_CYCCNTENA_Msk;
}

static void delay_us(uint32_t us) {
    uint32_t start = DWT->CYCCNT;
    uint32_t ticks = us * (SystemCoreClock / 1000000UL);
    while ((DWT->CYCCNT - start) < ticks) { }
}

// steps = |angle| / 360 * fullsteps_per_rev * microsteps_per_fullstep,
// done in integer arithmetic (no float) so the result is deterministic.
static uint32_t angle_to_microsteps(int32_t angle_deg)
{
    int32_t mag = (angle_deg < 0) ? -angle_deg : angle_deg;
    uint64_t num = (uint64_t)mag * MOTOR_FULLSTEPS_PER_REV * MICROSTEPS_PER_FULLSTEP;
    return (uint32_t)(num / 360);
}

// STEP/DIR move
static void tmc_step_move(uint32_t n_steps, uint8_t dir) {
    DIR_SET(dir);	// set/reset DIR pin
    delay_us(10);   // setup margin

    for (uint32_t i = 0; i < n_steps; i++) {	// toggle STEP pin for n steps calculated from angle_to_microsteps()
        STEP_HIGH();
        delay_us(STEP_PULSE_HIGH_US);
        STEP_LOW();
        delay_us(STEP_INTERVAL_US - STEP_PULSE_HIGH_US);
    }
}

