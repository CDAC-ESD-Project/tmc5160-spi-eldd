/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_SPI1_Init();
  /* USER CODE BEGIN 2 */
  DWT_Init();

  SPI_CS_DISABLE();
  DRV_DISABLE();
  STEP_LOW();
  DIR_SET(1);
  HAL_Delay(1000);   // halt for power to stabilize before any instructions/motion

  DRV_ENABLE();
  HAL_Delay(10);

  print_uart("---- TMC5160 bring-up (STEP/DIR motion, SPI config-only) ----\r\n");

  // check: confirm SPI link and identify the chip
  uint32_t ioin = tmc5160_read_reg(REG_IOIN);
  char buf[120];
  sprintf(buf, "IOIN=0x%08lX  VERSION=0x%02lX  SD_MODE=%lu  DRV_ENN=%lu  STEP_pin=%lu  DIR_pin=%lu\r\n",
          (unsigned long)ioin,
          (unsigned long)((ioin >> 24) & 0x1),	// VERSION  -> reads 0x30 for genuine TMC5160
          (unsigned long)((ioin >> 6)  & 0x1),	// SD_MODE  -> reads 1 (hardwired)
          (unsigned long)((ioin >> 4)  & 0x1),	// DRV_ENN
          (unsigned long)((ioin >> 0)  & 0x1),	// STEP pin state
          (unsigned long)((ioin >> 1)  & 0x1)	// DIR pin state
		  );
  print_uart(buf);

  // clear stale GSTAT flags from power-up
  tmc5160_write_reg(REG_GSTAT, 0x00000007);
  HAL_Delay(5);

  // driver configuration over SPI (current, microstepping, chopper, diagnostics)
  // DIAG0 is routed to fire on any driver error or overtemp pre-warning
  // DIAG1 is routed to fire on StallGuard stall, both are set to push-pull/active-HIGH
  // so they can be wired straight into the MCU's EXTI inputs with no external
  // pull-up needed.

  tmc5160_write_reg(REG_GCONF, (1UL << 5) | (1UL << 6) | (1UL << 8) | (1UL << 12) | (1UL << 13));
  //	5 -> DIAG0 pulses on driver error
  //	6 -> DIAG0 pulses on overtemp prewarning
  //	8 -> DIAG1 pulses on stall event
  //	12 -> DIAG0 push-pull, active HIGH, not open-drain
  //	13 -> DIAG1 push-pull, active HIGH, not open-drain

  // MRES=4 (16 microsteps/fullstep), TOFF=3, HSTRT=5, HEND=2, TBL=2, intpol=1
  // update MICROSTEPS_PER_FULLSTEP to match
  tmc5160_write_reg(REG_CHOPCONF, 0x14010153);

  // 200/256 current scaling
  tmc5160_write_reg(REG_GLOBAL_SCALER, 0x000000C8);

  // IHOLD=10, IRUN=22, IHOLDDELAY=6
  tmc5160_write_reg(REG_IHOLD_IRUN, 0x0006160A);
  tmc5160_write_reg(REG_TPOWERDOWN, 0x0000000A);
  tmc5160_write_reg(REG_TCOOLTHRS, 0x00000000);

  // define current position as zero -- once only
  tmc5160_write_reg(REG_XACTUAL, 0x00000000);
  HAL_Delay(5);

  // STEP/DIR pulses for movement, sized from ROTATION_ANGLE_DEG
  uint32_t n_steps = angle_to_microsteps(ROTATION_ANGLE_DEG);
  uint8_t  dir = (ROTATION_ANGLE_DEG >= 0) ? 1 : 0;

  sprintf(buf, "Moving %d deg (%s, %lu microsteps) via STEP/DIR...\r\n", ROTATION_ANGLE_DEG, dir ? "forward" : "reverse", (unsigned long)n_steps);
  print_uart(buf);

  tmc_step_move(n_steps, dir);

  tmc5160_status_line();

  print_uart("---- move complete -- driver left enabled, monitoring DIAG0/DIAG1 ----\r\n");

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1) {
    // the ISR only sets a flag, all the actual SPI/UART work happens here in normal (non-interrupt) context.
    if (diag0_event) {
        diag0_event = 0;
        tmc5160_report_faults("DIAG0");
    }
    if (diag1_event) {
        diag1_event = 0;
        tmc5160_report_faults("DIAG1");
    }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

